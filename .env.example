# Contoh file konfigurasi layanan proxy
# Salin file ini sebagai .env dan ubah nilai konfigurasi sesuai kebutuhan

# ========== Konfigurasi Dasar API ==========
# Kunci autentikasi klien (kunci API kustom Anda, digunakan untuk akses klien ke layanan ini)
AUTH_TOKEN=sk-your-api-key

# Lewati autentikasi klien (hanya untuk lingkungan pengembangan)
SKIP_AUTH_TOKEN=false

# ========== Konfigurasi Pool Token Z.ai ==========
# Ambang batas kegagalan Token (berapa kali gagal sebelum ditandai sebagai tidak tersedia)
TOKEN_FAILURE_THRESHOLD=3

# Waktu habis pemulihan Token (detik, token gagal akan dicoba kembali setelah waktu ini)
TOKEN_RECOVERY_TIMEOUT=1800

# Mode pengguna anonim Z.AI
# false: Gunakan token otentikasi, secara otomatis turun ke permintaan anonim saat gagal
# true: Secara otomatis mendapatkan token akses sementara dari Z.ai, menghindari berbagi riwayat percakapan
ANONYMOUS_MODE=true

# ========== Konfigurasi LongCat ==========
# Token LongCat (satu token)
# LONGCAT_TOKEN=your_passport_token_here

# ========== Konfigurasi Server ==========
# Port pendengar layanan
LISTEN_PORT=8080

# Nama layanan
SERVICE_NAME=z-ai2api-server

# Log debug
DEBUG_LOGGING=false

# Prefiks path proxy terbalik Nginx (opsional, untuk deploy di sub-path)
# Contoh: ROOT_PATH=/ai2api maka layanan dideploy di http://domain.com/ai2api
# Biarkan kosong untuk deploy di path root
ROOT_PATH=

# Sakelar fungsi Function Call
TOOL_SUPPORT=true

# Batas pemindaian panggilan alat (jumlah karakter)
SCAN_LIMIT=200000

# ========== Konfigurasi Proxy ==========
# Konfigurasi proxy HTTP (opsional, untuk semua permintaan HTTP)
# Format: http://host:port atau http://user:password@host:port
# HTTP_PROXY=http://127.0.0.1:7890

# Konfigurasi proxy HTTPS (opsional, untuk semua permintaan HTTPS)
# Format sama seperti di atas
# HTTPS_PROXY=http://127.0.0.1:7890

# Konfigurasi proxy SOCKS5 (opsional, diterapkan ke HTTP dan HTTPS)
# Format: socks5://host:port atau socks5://user:password@host:port
# SOCKS5_PROXY=socks5://127.0.0.1:1080

# ========== Otentikasi Backend Manajemen ==========
# Kata sandi login backend manajemen (disarankan untuk mengganti dengan kata sandi kompleks)
ADMIN_PASSWORD=admin123

# Kunci Session (untuk mengenkripsi sesi, disarankan membuat string acak)
SESSION_SECRET_KEY=your-secret-key-change-in-production
